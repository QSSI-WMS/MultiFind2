<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from AppIcon.cs by the test harness's icons run, not hand-drawn. -->
    <ApplicationIcon>MultiFind2.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>MultiFind2</AssemblyTitle>
    <Product>MultiFind2</Product>
    <Company>QSSI-WMS</Company>
    <Version>1.3.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Searching inside archives. Covers zip, 7z, gzip, tar and rar in one managed library,
         with no shell-out to 7z.exe and nothing native to ship. -->
    <PackageReference Include="SharpCompress" Version="0.50.6" />
  </ItemGroup>

</Project>